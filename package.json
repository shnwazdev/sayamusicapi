{
  "name": "sayamusicapi",
  "version": "0.1.0",
  "description": "A Cloudflare Workers music API for legal search, metadata, artwork, previews, and open/free streams.",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "wrangler dev src/index.ts --local --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "endpoints": "tsx scripts/list-endpoints.ts",
    "audit:endpoints": "tsx scripts/audit-endpoints.ts",
    "audit:endpoints:smoke": "tsx scripts/audit-endpoints.ts --smoke --concurrency=8 --timeout=15000"
  },
  "keywords": [
    "music",
    "api",
    "cloudflare-workers",
    "hono",
    "itunes",
    "musicbrainz",
    "audius"
  ],
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260510.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
